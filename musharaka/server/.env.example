PORT=3001
DATABASE_URL=postgres://user:password@127.0.0.1:5432/urrwah_dev
REDIS_URL=redis://localhost:6379
ENCRYPTION_KEY=your-64-char-hex-key
JWT_SECRET=change-me-long-random-string

# Public host. CLIENT_ORIGIN is the CORS allow-list: comma-separated origins,
# scheme + host only, no path, no wildcard. REQUIRED in production (the server
# refuses to start without it).
#   production: CLIENT_ORIGIN=https://musharakah.urrwah.com
#   dev host:   CLIENT_ORIGIN=https://dev.urrwah.com
CLIENT_ORIGIN=http://localhost:5173
# Origin used in links we send (password-reset e-mail, bot user-guide link).
# Optional: defaults to the first CLIENT_ORIGIN entry.
# APP_URL=https://musharakah.urrwah.com
SEINOMY_BASE_URL=https://api.seinomy.com
SEINOMY_MOCK=true
SEINOMY_TIMEOUT=10000

# Public Contracts API — set a strong random key for machine-to-machine access
# Leave empty to require standard JWT auth only
CONTRACTS_API_KEY=

# Bot integrations (Telegram + WhatsApp/Twilio)
# Required when running webhook endpoints — leave empty to disable bot auth in dev
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=

# Internal deploy-time process kill key (generated random string)
# Must match INTERNAL_KILL_KEY in the VPS server/.env for /api/internal/shutdown to work
INTERNAL_KILL_KEY=
